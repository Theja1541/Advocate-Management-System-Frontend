154:   const pagedPending = pendingCases.slice(pendingStart, pendingStart + pageSize);
155: 
156:   const historyTotalPages = Math.max(1, Math.ceil(completedCases.length / pageSize));
157:   const historyCurrent = Math.min(historyPage, historyTotalPages);
158:   const historyStart = (historyCurrent - 1) * pageSize;
159:   const pagedHistory = completedCases.slice(historyStart, historyStart + pageSize);
