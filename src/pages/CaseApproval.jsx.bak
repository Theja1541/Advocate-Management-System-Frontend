70:   const [levelFilter, setLevelFilter] = useState('all');
71:   const [caseTypeFilter, setCaseTypeFilter] = useState('all');
72:   const [pendingPage, setPendingPage] = useState(1);
73:   const [historyPage, setHistoryPage] = useState(1);
74: 
75:   const loadData = useCallback(async () => {
76:     setLoading(true);
77:     setError('');
78:     try {
79:       const [caseList, clientList, typeList] = await Promise.all([
80:         getCases(),
81:         getClients(),
82:         getCaseTypes(true),
83:       ]);
84:       setCases(caseList);
85:       setClients(clientList);
86:       setCaseTypes(typeList);
