142:     if (caseTypeFilter !== 'all' && c.caseTypeDisplay !== caseTypeFilter) return false;
143:     if (!q) return true;
144:     const haystack = [c.caseNo, c.caseTypeDisplay, c.opponent, getClientName(c.clientId)]
145:       .filter(Boolean)
146:       .join(' ')
