164:     let nextStatus = caseItem.status;
165: 
166:     if (direction > 0) {
167:       nextLevel = Math.min(3, current + 1);
168:       nextStatus = nextLevel >= 3 ? 'Active' : 'Pending Approval';
169:     } else {
