13: const TITLE_META_SEP = ' :: ';
14: const TITLE_VS_SEP = ' — vs ';
15: 
16: const LEVEL_FILTERS = [
17:   { key: 'all', label: 'All pending' },
18:   { key: '0', label: 'Level 1' },
19:   { key: '1', label: 'Level 2' },
20:   { key: '2', label: 'Level 3' },
21: ];
22: 
23: const parseTitle = (title = '') => {
24:   const [head = '', stage = 'Filing', val = '0', fee = '10'] = String(title).split(TITLE_META_SEP);
25:   let caseType = head;
26:   let opponent = '';
27:   const vsIdx = head.indexOf(TITLE_VS_SEP);
28:   if (vsIdx >= 0) {
29:     caseType = head.slice(0, vsIdx);
30:     opponent = head.slice(vsIdx + TITLE_VS_SEP.length);
31:   }
32:   return {
33:     caseType: caseType || title || '—',
34:     opponent: opponent || '—',
35:     stage: stage || 'Filing',
36:     val: Number(val) || 0,
37:     fee: Number(fee) || 0,
38:   };
39: };
40: 
41: const formatHistoryDate = (value) => {
42:   if (!value) return '—';
43:   const d = new Date(value);
44:   if (Number.isNaN(d.getTime())) return '—';
45:   return d.toLocaleDateString('en-GB', {
46:     day: '2-digit',
47:     month: 'short',
48:     year: 'numeric',
49:   });
50: };
51: 
52: const getApprovalLevel = (c) => {
53:   const level = Number(c.approvalLevel);
54:   if (Number.isNaN(level) || level < 0) return 0;
55:   return Math.min(3, level);
56: };
57: 
58: export default function CaseApproval() {
59:   const { hasPermission, user } = useAuth();
60:   const canApprove = hasPermission('approve', 'A');
61: 
62:   const [cases, setCases] = useState([]);
